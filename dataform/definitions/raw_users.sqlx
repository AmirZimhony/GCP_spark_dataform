config {
  type: "operations",
  hasOutput: true,
  schema: "raw",
  tags: ["raw"],
  description: "External table over users.csv in GCS."
}

CREATE OR REPLACE EXTERNAL TABLE ${self()} (
  user_id INT64,
  name STRING,
  email STRING,
  updated_at STRING
)
OPTIONS (
  format = "CSV",
  uris = ["gs://${dataform.projectConfig.vars.gcsBucket}/${dataform.projectConfig.vars.gcsPrefix}/users.csv"],
  skip_leading_rows = 1,
  field_delimiter = ",",
  allow_quoted_newlines = true
);
