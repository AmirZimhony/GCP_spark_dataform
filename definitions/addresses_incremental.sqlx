config {
  type: "incremental",
  uniqueKey: ["address_id"],
  tags: ["incremental"],
  description: "Incrementally upserts addresses from the existing BigQuery addresses table.",
  bigquery: {
    partitionBy: "DATE(updated_at)",
    clusterBy: ["user_id"]
  }
}

SELECT
  address_id,
  user_id,
  city,
  street,
  CAST(updated_at AS TIMESTAMP) AS updated_at
FROM `project-d2e743fd-f7fe-4894-a24.home_Assignments.addresses`

${when(
  incremental(),
  `WHERE CAST(updated_at AS TIMESTAMP) > (
    SELECT COALESCE(MAX(updated_at), TIMESTAMP('1970-01-01'))
    FROM ${self()}
  )`
)}