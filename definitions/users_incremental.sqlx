config {
  type: "incremental",
  uniqueKey: ["user_id"],
  tags: ["incremental"],
  description: "Incrementally upserts users from the existing BigQuery users table.",
  bigquery: {
    partitionBy: "DATE(updated_at)",
    clusterBy: ["user_id"]
  }
}

SELECT
  user_id,
  name,
  email,
  CAST(updated_at AS TIMESTAMP) AS updated_at
FROM `project-d2e743fd-f7fe-4894-a24.home_Assignments.users`

${when(
  incremental(),
  `WHERE CAST(updated_at AS TIMESTAMP) > (
    SELECT COALESCE(MAX(updated_at), TIMESTAMP('1970-01-01'))
    FROM ${self()}
  )`
)}